local function addLog(message)
    table.insert(logLines,
        os.date("%H:%M:%S") .. " • " .. message)

    while #logLines > 2 do
        table.remove(logLines, 1)
    end

    log.Text = table.concat(logLines, "\n")
end

for i, name in ipairs(options) do
    local col = (i - 1) % 2
    local row = math.floor((i - 1) / 2)

    local btn = create("TextButton", {
        Size = UDim2.fromOffset(232, 51),
        Position = UDim2.fromOffset(
            24 + col * 246,
            370 + row * 58
        ),
        Text = "○  " .. name,
        TextColor3 = Color3.fromRGB(105, 55, 40),
        Font = Enum.Font.GothamBold,
        TextSize = 15
    })

    round(btn, 15)
    gradient(btn)

    enabled[name] = false

    btn.MouseButton1Click:Connect(function()
        enabled[name] = not enabled[name]

        btn.Text = (enabled[name] and "✓  " or "○  ") .. name

        addLog(name ..
            (enabled[name] and " enabled" or " disabled"))
    end)
end

-- START / STOP
local running = false
local startedAt = 0

start.MouseButton1Click:Connect(function()
    running = not running

    if running then
        startedAt = os.clock()
        start.Text = "■  STOP MACRO"
        status.Text = "🟢 Macro Running"
        addLog("Macro started")
    else
        start.Text = "▶  START MACRO"
        status.Text = "🟢 Macro Idle"
        addLog("Macro stopped")
    end
end)

-- RUNTIME
task.spawn(function()
    while gui.Parent do
        if running then
            local elapsed = math.floor(os.clock() - startedAt)
            runtime.Text = string.format(
                "RUN TIME     %02d:%02d:%02d",
                math.floor(elapsed / 3600),
                math.floor(elapsed % 3600 / 60),
                elapsed % 60
            )
        end
        task.wait(1)
    end
end)

